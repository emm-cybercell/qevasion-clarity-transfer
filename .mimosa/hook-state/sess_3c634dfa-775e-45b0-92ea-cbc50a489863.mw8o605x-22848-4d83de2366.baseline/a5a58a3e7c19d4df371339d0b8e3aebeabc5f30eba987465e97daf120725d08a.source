# -*- coding: utf-8 -*-
"""Cross-scenario transfer to QNLI + data-efficiency extension.

Parts
-----
1. zero-shot direct reuse: the QEvasion-fine-tuned BERT is applied to QNLI.
   A label-projection adapter maps Clear Reply -> entailment, the two
   non-reply classes -> not_entailment.
2. adapted retraining: TF-IDF+LR and BERT are retrained on QNLI with the
   same unified schema.
3. data efficiency: BERT retrained on 10% / 30% / 100% of the QNLI pool.
"""
import os
import json
import subprocess
import sys

import numpy as np
import pandas as pd
import torch
from transformers import AutoTokenizer, AutoModelForSequenceClassification

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RES = os.path.join(HERE, "results")
SEED = 42

COARSE = ["Clear Reply", "Ambivalent", "Clear Non-Reply"]
# projection adapter: coarse clarity -> QNLI entailment decision
COARSE2QNLI = {"Clear Reply": "entailment",
               "Ambivalent": "not_entailment",
               "Clear Non-Reply": "not_entailment"}


def bert_zero_shot():
    """Apply the QEvasion BERT checkpoint to QNLI dev and project labels."""
    run = os.path.join(RES, "bert_qev_coarse", "model")
    device = "cuda" if torch.cuda.is_available() else "cpu"
    tok = AutoTokenizer.from_pretrained(run)
    model = AutoModelForSequenceClassification.from_pretrained(run).to(device)
    te = pd.read_csv(os.path.join(HERE, "data", "qnli_dev.csv"))

    from train_bert import PairDataset, predict
    from torch.utils.data import DataLoader
    dl = DataLoader(PairDataset(te, tok, 256), batch_size=64)
    y_true, y_pred, _ = predict(model, dl, device)
    # index -> coarse name -> entailment decision
    proj = np.array([COARSE2QNLI[COARSE[i]] == "entailment" for i in y_pred],
                    dtype=int)
    acc = float((proj == y_true).mean())
    from sklearn.metrics import f1_score, confusion_matrix
    mf1 = float(f1_score(y_true, proj, average="macro"))
    out = {"accuracy": round(acc, 4), "macro_f1": round(mf1, 4),
           "confusion_matrix": confusion_matrix(y_true, proj).tolist(),
           "note": "zero-shot: qev bert + coarse->entailment projection"}
    with open(os.path.join(RES, "transfer_zero_shot.json"), "w",
              encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    print(json.dumps(out, indent=2))


def run(cmd):
    print("+", " ".join(cmd), flush=True)
    r = subprocess.run([sys.executable] + cmd, cwd=HERE)
    if r.returncode != 0:
        sys.exit(r.returncode)


def load_json(p):
    with open(p, encoding="utf-8") as f:
        return json.load(f)


def main():
    os.makedirs(os.path.join(RES, "predictions"), exist_ok=True)

    # ---- 1. zero-shot direct reuse ------------------------------------
    bert_zero_shot()

    # ---- 2. adapted retraining on QNLI (TF-IDF+LR full data) ----------
    run(["src/train_tfidf.py", "--task", "qnli"])
    run(["src/train_sbert.py", "--task", "qnli"])

    # ---- 3. data-efficiency BERT runs ----------------------------------
    for frac, cap in [("10", 2000), ("30", 6000), ("100", 20000)]:
        run(["src/train_bert.py",
             "--train", "data/qnli_train.csv",
             "--test", "data/qnli_dev.csv",
             "--num_labels", "2", "--names", "not_entailment|entailment",
             "--run_name", f"bert_qnli_{frac}pct",
             "--max_train", str(cap),
             "--epochs", "3", "--batch_size", "32", "--max_len", "256"])

    # ---- summary -------------------------------------------------------
    summary = {}
    zs = load_json(os.path.join(RES, "transfer_zero_shot.json"))
    summary["zero_shot_bert"] = {"accuracy": zs["accuracy"],
                                 "macro_f1": zs["macro_f1"]}
    for name in ["bert_qnli_10pct", "bert_qnli_30pct", "bert_qnli_100pct"]:
        m = load_json(os.path.join(RES, name, "metrics.json"))
        summary[name] = {"accuracy": m["accuracy"],
                         "macro_f1": m["macro_f1"],
                         "train_size": m["config"]["train_size"]}
    tf = load_json(os.path.join(RES, "baselines_qnli.json"))
    summary["tfidf_lr_qnli"] = {"accuracy": tf["tfidf_lr"]["accuracy"],
                                "macro_f1": tf["tfidf_lr"]["macro_f1"]}
    with open(os.path.join(RES, "transfer_summary.json"), "w",
              encoding="utf-8") as f:
        json.dump(summary, f, ensure_ascii=False, indent=2)
    print(json.dumps(summary, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
