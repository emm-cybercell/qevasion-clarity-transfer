# -*- coding: utf-8 -*-
"""Baseline 4 / main model: fine-tuned BERT-base-uncased on (question,
answer) pairs. Also reused for the QNLI transfer runs and the
data-efficiency extension.

Examples
--------
python src/train_bert.py --train data/qev_train.csv --test data/qev_test.csv \
    --num_labels 3 --names "Clear Reply,Ambivalent,Clear Non-Reply" \
    --run_name bert_qev_coarse
python src/train_bert.py --train data/qev_train.csv --dev_split 0.1 \
    --label_col fine --num_labels 9 --names "Explicit,Dodging,..." \
    --run_name bert_qev_fine
"""
import os
import sys
import json
import random
import argparse
import time

import numpy as np
import pandas as pd
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from transformers import (AutoTokenizer, AutoModelForSequenceClassification,
                          get_linear_schedule_with_warmup)
from sklearn.model_selection import train_test_split
from sklearn.metrics import (accuracy_score, f1_score,
                             precision_recall_fscore_support,
                             confusion_matrix)

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RES = os.path.join(HERE, "results")
MODEL_NAME = "bert-base-uncased"
SEED = 42


def set_seed(seed=SEED):
    random.seed(seed); np.random.seed(seed); torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


class PairDataset(Dataset):
    def __init__(self, df, tokenizer, max_len, label_col="label"):
        self.q = df["text_a"].tolist()
        self.a = df["text_b"].tolist()
        self.y = df[label_col].astype(int).tolist()
        self.tok = tokenizer
        self.max_len = max_len

    def __len__(self):
        return len(self.y)

    def __getitem__(self, i):
        enc = self.tok(self.q[i], self.a[i], truncation="longest_first",
                       max_length=self.max_len, padding="max_length",
                       return_tensors="pt")
        return {"input_ids": enc["input_ids"][0],
                "attention_mask": enc["attention_mask"][0],
                "labels": torch.tensor(self.y[i], dtype=torch.long)}


@torch.no_grad()
def predict(model, loader, device):
    model.eval()
    preds, ys, probs = [], [], []
    for batch in loader:
        batch = {k: v.to(device) for k, v in batch.items()}
        out = model(**batch)
        p = out.logits.softmax(-1)
        preds.extend(p.argmax(-1).cpu().tolist())
        probs.extend(p.cpu().tolist())
        ys.extend(batch["labels"].cpu().tolist())
    return np.array(ys), np.array(preds), np.array(probs)


def evaluate_block(y_true, y_pred, names):
    labels = list(range(len(names)))
    acc = accuracy_score(y_true, y_pred)
    mf1 = f1_score(y_true, y_pred, average="macro")
    p, r, f, sup = precision_recall_fscore_support(y_true, y_pred,
                                                   labels=labels,
                                                   zero_division=0)
    cm = confusion_matrix(y_true, y_pred, labels=labels)
    return {"accuracy": round(float(acc), 4),
            "macro_f1": round(float(mf1), 4),
            "per_class": {tn: {"precision": round(float(pi), 4),
                               "recall": round(float(ri), 4),
                               "f1": round(float(fi), 4),
                               "support": int(si)}
                          for tn, pi, ri, fi, si in zip(names, p, r, f, sup)},
            "confusion_matrix": cm.tolist()}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--train", required=True)
    ap.add_argument("--test", default=None)
    ap.add_argument("--dev_split", type=float, default=0.0,
                    help="if >0 and no --test, carve dev from train")
    ap.add_argument("--label_col", default="label")
    ap.add_argument("--num_labels", type=int, default=3)
    ap.add_argument("--names", default="0,1,2")
    ap.add_argument("--run_name", required=True)
    ap.add_argument("--max_len", type=int, default=384)
    ap.add_argument("--epochs", type=int, default=4)
    ap.add_argument("--batch_size", type=int, default=16)
    ap.add_argument("--lr", type=float, default=2e-5)
    ap.add_argument("--warmup", type=float, default=0.1)
    ap.add_argument("--fp16", action="store_true", default=True)
    ap.add_argument("--save_model", action="store_true")
    ap.add_argument("--max_train", type=int, default=0,
                    help="cap training rows (data-efficiency study)")
    args = ap.parse_args()
    names = args.names.split("|") if "|" in args.names else args.names.split(",")
    device = "cuda" if torch.cuda.is_available() else "cpu"
    set_seed()

    tr = pd.read_csv(os.path.join(HERE, args.train))
    if args.max_train and args.max_train < len(tr):
        # stratified subsample keeps the label ratio of the data-efficiency runs
        tr, _ = train_test_split(tr, train_size=args.max_train,
                                 stratify=tr[args.label_col],
                                 random_state=SEED)
    if args.test:
        te = pd.read_csv(os.path.join(HERE, args.test))
    else:
        tr, te = train_test_split(tr, test_size=args.dev_split,
                                  stratify=tr[args.label_col],
                                  random_state=SEED)
    tr = tr.reset_index(drop=True); te = te.reset_index(drop=True)

    tok = AutoTokenizer.from_pretrained(MODEL_NAME)
    model = AutoModelForSequenceClassification.from_pretrained(
        MODEL_NAME, num_labels=args.num_labels).to(device)

    dl_tr = DataLoader(PairDataset(tr, tok, args.max_len, args.label_col),
                       batch_size=args.batch_size, shuffle=True)
    dl_te = DataLoader(PairDataset(te, tok, args.max_len, args.label_col),
                       batch_size=args.batch_size * 2)

    total = len(dl_tr) * args.epochs
    opt = torch.optim.AdamW(model.parameters(), lr=args.lr,
                            weight_decay=0.01)
    sched = get_linear_schedule_with_warmup(opt, int(total * args.warmup),
                                            total)
    scaler = torch.amp.GradScaler("cuda", enabled=args.fp16 and device == "cuda")

    log_lines = [f"[{args.run_name}] train={len(tr)} test={len(te)} "
                 f"max_len={args.max_len} epochs={args.epochs} "
                 f"bs={args.batch_size} lr={args.lr} device={device}"]
    print(log_lines[-1], flush=True)
    t0 = time.time()
    step = 0
    for ep in range(1, args.epochs + 1):
        model.train()
        running = 0.0
        for i, batch in enumerate(dl_tr, 1):
            batch = {k: v.to(device) for k, v in batch.items()}
            opt.zero_grad(set_to_none=True)
            with torch.amp.autocast("cuda", enabled=args.fp16 and device == "cuda"):
                out = model(**batch)
                loss = out.loss
            scaler.scale(loss).backward()
            scaler.unscale_(opt)
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            scaler.step(opt); scaler.update(); sched.step()
            running += loss.item(); step += 1
            if i % 50 == 0:
                msg = (f"epoch {ep}/{args.epochs} step {i}/{len(dl_tr)} "
                       f"loss {running / i:.4f} elapsed {time.time()-t0:.0f}s")
                print(msg, flush=True)
                log_lines.append(msg)
    train_time = time.time() - t0

    y_true, y_pred, probs = predict(model, dl_te, device)
    metrics = evaluate_block(y_true, y_pred, names)
    metrics["train_seconds"] = round(train_time, 1)
    metrics["config"] = {
        "model": MODEL_NAME, "max_len": args.max_len,
        "epochs": args.epochs, "batch_size": args.batch_size,
        "lr": args.lr, "warmup_ratio": args.warmup,
        "optimizer": "AdamW(wd=0.01)", "seed": SEED,
        "train_size": int(len(tr)), "test_size": int(len(te)),
        "label_col": args.label_col, "run_name": args.run_name,
    }

    rundir = os.path.join(RES, args.run_name)
    os.makedirs(rundir, exist_ok=True)
    pd.DataFrame({"y_true": y_true, "y_pred": y_pred}).to_csv(
        os.path.join(rundir, "predictions.csv"), index=False)
    np.save(os.path.join(rundir, "probs.npy"), probs)
    with open(os.path.join(rundir, "metrics.json"), "w", encoding="utf-8") as f:
        json.dump(metrics, f, ensure_ascii=False, indent=2)
    with open(os.path.join(rundir, "train_log.txt"), "w", encoding="utf-8") as f:
        f.write("\n".join(log_lines))
    if args.save_model:
        model.save_pretrained(os.path.join(rundir, "model"))
        tok.save_pretrained(os.path.join(rundir, "model"))
    print(json.dumps(metrics, ensure_ascii=False, indent=2), flush=True)


if __name__ == "__main__":
    main()
